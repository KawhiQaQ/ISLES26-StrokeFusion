!scripts/build_checkpoint_swa.py
!scripts/build_center_grouped_folds.py
!scripts/evaluate_isles26.py
!scripts/evaluate_probability_ensemble.py
!scripts/package_final_model.sh
!scripts/prepare_nnunet_dataset.py
!scripts/prepare_data.sh
!scripts/restore_final_models.sh
!scripts/predict.py
!scripts/verify_inference_release.py
!scripts/smoke_primus_local_refinement.py
!scripts/smoke_resenc_rass.py
!scripts/train_primus_local_refinement.sh
!scripts/train_resenc_rass.sh
!scripts/train_strokefusion.sh
!scripts/verify_final_release.sh

